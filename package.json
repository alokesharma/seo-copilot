{
  "name": "seo-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:init": "wrangler d1 execute seo-copilot --local --file=schema.sql",
    "db:reset": "wrangler d1 execute seo-copilot --local --command \"DROP TABLE IF EXISTS gsc_daily; DROP TABLE IF EXISTS query_daily; DROP TABLE IF EXISTS url_keywords; DROP TABLE IF EXISTS page_freshness; DROP TABLE IF EXISTS serp_cache; DROP TABLE IF EXISTS meta;\" && npm run db:init",
    "backfill": "node scripts/backfill.mjs",
    "keywords": "node scripts/keywords-backfill.mjs",
    "freshness-sf": "node scripts/freshness-sf.mjs",
    "freshness-ahrefs": "NODE_TLS_REJECT_UNAUTHORIZED=0 node scripts/freshness-ahrefs.mjs",
    "dev": "vite build && wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "refresh": "node scripts/backfill.mjs && node scripts/build-rollups.mjs && node scripts/freshness-sf.mjs",
    "build": "vite build",
    "start": "npm run dev",
    "setup": "npm install && npm run db:init && npm run dev"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "animejs": "^4.5.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "framer-motion": "^12.42.2",
    "geist": "^1.7.2",
    "google-auth-library": "^9.14.0",
    "hammerjs": "^2.0.8",
    "lucide-react": "^1.47.0",
    "motion": "^13.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.63.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  }
}
